{
  "name": "@ia-erp/medusa-mercadopago-storefront",
  "version": "0.1.0",
  "description": "Botón y página de retorno de Mercado Pago Checkout Pro para storefronts de Medusa v2 (React y Next.js), para usar con @ia-erp/medusa-payment-mercadopago.",
  "author": "IA ERP <support@ia-erp.cl>",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "checkout-pro",
    "medusa",
    "medusa-v2",
    "mercadopago",
    "mercado-pago",
    "nextjs",
    "react",
    "storefront"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "npm run build && tsc -p test/tsconfig.json && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@medusajs/js-sdk": ">=2.11.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@medusajs/js-sdk": "2.22.6",
    "@medusajs/types": "2.22.6",
    "@types/react": "19.2.18",
    "react": "19.2.9",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KSS-Develop/medusa-payment-mercadopago.git",
    "directory": "storefront"
  },
  "homepage": "https://github.com/KSS-Develop/medusa-payment-mercadopago/tree/main/storefront#readme",
  "bugs": {
    "url": "https://github.com/KSS-Develop/medusa-payment-mercadopago/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
